# Local development configuration for `pnpm dev` (root).
#
# Copy this file to `.env.dev` (git-ignored) and fill in your own values.
# Values you leave blank are OK: the launcher supplies sensible defaults for
# everything it controls. Full walkthrough: docs/local-development.md.
#
# Anything you already have in `artifacts/kindred-coach/.env.local` (the
# Auth0 onboarding file) keeps working: Vite falls back to it for any
# VITE_* key not set here.

# --- Ports & origins (launcher-managed) --------------------------------------
KINDRED_WEB_PORT=8080
KINDRED_API_PORT=3000
KINDRED_API_ORIGIN=http://127.0.0.1:3000
BASE_PATH=/

# --- Development database -----------------------------------------------------
# disposable: the launcher runs an in-memory MongoDB replica set just for you
#             (data is lost when `pnpm dev` stops). No installation needed.
# external:   point MONGODB_URI/MONGODB_DATABASE below at your own local MongoDB.
KINDRED_DEV_DB=disposable
# MONGODB_URI=mongodb://127.0.0.1:27017
# MONGODB_DATABASE=kindred_dev

# --- Frontend (public VITE_* values only) -------------------------------------
# Secret values must NOT be placed here: anything in this file is passed to
# the browser. Use the documented dev tenant values from
# docs/auth0-migration.md (public identifiers) or leave the client id blank
# to fall back to artifacts/kindred-coach/.env.local.
VITE_AUTH0_DOMAIN=dev-rio3w0hvdl6hccn6.us.auth0.com
VITE_AUTH0_CLIENT_ID=
VITE_AUTH0_AUDIENCE=https://kindred-asterling-ai-coaching.com/api

# --- Backend ------------------------------------------------------------------
# The backend refuses to start unless AI_PROVIDER is set; "disabled" gives a
# runnable dev API without any AI provider. Switch to openai/ollama/bedrock
# and add the matching keys only when you need AI responses locally.
AI_PROVIDER=disabled
LOG_LEVEL=info
APP_PUBLIC_URL=http://localhost:8080
AUTH0_DOMAIN=dev-rio3w0hvdl6hccn6.us.auth0.com
AUTH0_AUDIENCE=https://kindred-asterling-ai-coaching.com/api
# REMINDER_SCHEDULER_DISABLED is set automatically by the launcher and should
# not be edited here. Production never sets it, so scheduling is unchanged.

# --- Optional integrations (leave blank unless you need them locally) --------
# RESEND_API_KEY=
# RESEND_FROM_EMAIL=
# OPENAI_API_KEY=
# OPENAI_MODEL=
# AWS_REGION=
# BEDROCK_MODEL_ID=
# HELCIM_PAYMENTS_ENABLED=false