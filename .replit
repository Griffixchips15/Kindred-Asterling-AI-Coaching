modules = ["nodejs-24", "python-3.11", "postgresql-16"]

[deployment]
router = "application"
deploymentTarget = "gce"

[deployment.postBuild]
args = ["pnpm", "store", "prune"]
env = { "CI" = "true" }

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "artifacts/kindred-coach: web"
author = "agent"
mode = "parallel"

[workflows.workflow.metadata]
outputType = "webview"
artifactId = "artifacts/kindred-coach"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "pnpm --filter @workspace/kindred-coach run dev"
cwd = "./artifacts/kindred-coach"
waitForPort = 23546
router = "path"

[workflows.workflow.tasks.env]
PORT = "23546"
BASE_PATH = "/"

[[workflows.workflow]]
name = "artifacts/api-server: API Server"
author = "agent"
mode = "sequential"

[workflows.workflow.metadata]
outputType = "none"
artifactId = "3B4_FFSkEVBkAeYMFRJ2e"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "pnpm --filter @workspace/api-server run dev"
cwd = "./artifacts/api-server"
waitForPort = 8080

[workflows.workflow.tasks.env]
PORT = "8080"

[[workflows.workflow]]
name = "artifacts/mockup-sandbox: Component Preview Server"
author = "agent"
mode = "sequential"

[workflows.workflow.metadata]
outputType = "webview"
artifactId = "XegfDyZt7HqfW2Bb8Ghoy"
isCanvasWorkflow = true

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "pnpm --filter @workspace/mockup-sandbox run dev"
cwd = "./artifacts/mockup-sandbox"
waitForPort = 8081

[workflows.workflow.tasks.env]
PORT = "8081"
BASE_PATH = "/__mockup"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "test"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "typecheck"

[[workflows.workflow]]
name = "test"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "pnpm --filter @workspace/api-server run test"

[workflows.workflow.metadata]
isValidation = true

[[workflows.workflow]]
name = "typecheck"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "pnpm run typecheck"

[workflows.workflow.metadata]
isValidation = true

[agent]
stack = "PNPM_WORKSPACE"
expertMode = true
integrations = ["google-calendar:1.0.0", "twilio:1.0.0"]

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 20000

[[ports]]
localPort = 8080
externalPort = 8080

[[ports]]
localPort = 8081
externalPort = 80

[[ports]]
localPort = 8082
externalPort = 3002

[[ports]]
localPort = 8083
externalPort = 3001

[[ports]]
localPort = 23546
externalPort = 3000

[nix]
channel = "stable-25_05"

[userenv]

[userenv.shared]
CALENDAR_OWNER_USER_ID = "50312031"
# SQUARE_* vars are legacy — kept only to preserve old env values for rollback.
# The app no longer uses Square. Helcim is the current payment provider.
SQUARE_ENVIRONMENT = "production"
SQUARE_STORE_URL = "https://kindred-ai001.square.site/"
# Legacy — replaced by SUBSCRIPTION_OWNER_IDS (immutable user IDs).
# SUBSCRIPTION_BYPASS_EMAILS = "asterling.digital@pm.me,cybermonkey9647@gmail.com"
SQUARE_LOCATION_ID = "LKJP26P6A2G7S"
SQUARE_YEARLY_VARIATION_ID = "VKCS3WDZH3J3JP6GTCGWBIHB"
SQUARE_LIFETIME_VARIATION_ID = "5TXRWGUDUOMGNSBKFPFYNJAN"
