# =============================================================================
# Kindred Asterling AI Coaching — 1Password Secret References
# =============================================================================
# Format: op://<vault>/<item>/<field>
# Start with: op run --env-file=".env.1password" -- pnpm --filter @workspace/api-server run dev
#
# IMPORTANT: This file contains ONLY references, never resolved values.
#            It is safe to commit to version control.

# ── Database ─────────────────────────────────────────────────────────────────
DATABASE_URL=op://Kindred AI Server/Kindred - Database Development/credential

# ── Authentication / Sessions ────────────────────────────────────────────────
SESSION_SECRET=op://Kindred AI Server/Kindred - Session Secret/credential

# ── AI Providers ─────────────────────────────────────────────────────────────

# ── Payments (Stripe) ───────────────────────────────────────────────────────
STRIPE_SECRET_KEY=op://Kindred AI Server/Kindred - Stripe Test/secret key
STRIPE_YEARLY_PRICE_ID=op://Kindred AI Server/Kindred - Stripe Test/yearly price id
STRIPE_LIFETIME_PRICE_ID=op://Kindred AI Server/Kindred - Stripe Test/lifetime price id
STRIPE_WEBHOOK_SECRET=op://Kindred AI Server/Kindred - Stripe Test/webhook secret

# ── Messaging: SMS (Twilio) ─────────────────────────────────────────────────
TWILIO_ACCOUNT_SID=op://Kindred AI Server/Kindred - Twilio Development/account sid
TWILIO_AUTH_TOKEN=op://Kindred AI Server/Kindred - Twilio Development/auth token
TWILIO_PHONE_NUMBER=op://Kindred AI Server/Kindred - Twilio Development/phone number

# ── Messaging: Email (Resend) ────────────────────────────────────────────────
RESEND_API_KEY=op://Kindred AI Server/Kindred - Resend Development/api key
RESEND_FROM_EMAIL=op://Kindred AI Server/Kindred - Resend Development/from email

# ── Voice (ElevenLabs) ──────────────────────────────────────────────────────
ELEVENLABS_API_KEY=op://Kindred AI Server/Kindred - ElevenLabs Development/api key

# ── Application / Runtime ────────────────────────────────────────────────────
PORT=8080
NODE_ENV=development
APP_PUBLIC_URL=http://localhost:8080
LOG_LEVEL=debug

# ── Feature Flags / App Logic ───────────────────────────────────────────────
CALENDAR_OWNER_USER_ID=op://Kindred AI Server/Kindred - App Config/calendar owner user id
SUBSCRIPTION_BYPASS_EMAILS=op://Kindred AI Server/Kindred - App Config/subscription bypass emails
