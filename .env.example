# =============================================================================
# Kindred Asterling AI Coaching — Environment Template
# =============================================================================
# This file contains variable NAMES ONLY. Never commit real values.
# Copy to .env and fill in locally, or use .env.1password with `op run`.

# ── Database ─────────────────────────────────────────────────────────────────
DATABASE_URL=         # Restricted application role
MIGRATION_DATABASE_URL= # Schema-owner role; migration job/startup only
PG_SSL_CA=             # Required PEM CA for private/self-signed production certificates

# ── Authentication / Sessions ────────────────────────────────────────────────
SESSION_SECRET=

# ── AI Providers ─────────────────────────────────────────────────────────────
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=gemma3:4b

# ── Payments (Helcim) ────────────────────────────────────────────────────────
HELCIM_API_KEY=
HELCIM_WEBHOOK_SECRET=
HELCIM_YEARLY_PLAN_ID=
HELCIM_LIFETIME_PRODUCT_ID=
HELCIM_YEARLY_CHECKOUT_URL=
HELCIM_LIFETIME_CHECKOUT_URL=
HELCIM_PORTAL_URL=https://kindred-asterling-ai.helcim.app/login

# ── Messaging: SMS (Twilio) ─────────────────────────────────────────────────
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# ── Messaging: Email (Resend) ────────────────────────────────────────────────
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# ── Voice (ElevenLabs) ──────────────────────────────────────────────────────
ELEVENLABS_API_KEY=

# ── Application / Runtime ────────────────────────────────────────────────────
PORT=8080
NODE_ENV=development
APP_PUBLIC_URL=
LOG_LEVEL=info

# ── Feature Flags / App Logic ───────────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALENDAR_REDIRECT_URI=
CALENDAR_OAUTH_STATE_SECRET=
CALENDAR_TOKEN_ENCRYPTION_KEY=
SUBSCRIPTION_OWNER_IDS=
SUBSCRIPTION_OWNER_EMAILS=
DAILY_CHAT_LIMIT=100
