# Kindred Asterling AI Coaching configuration
# Copy this file to .env and replace placeholders for local development.
# In Coolify, add the same names as runtime variables/secrets. VITE_* entries
# are public build arguments; never put a secret in a VITE_* variable.

# Public browser build configuration
VITE_CLERK_PUBLISHABLE_KEY=
VITE_SENTRY_DSN=
VITE_SENTRY_ENABLED=true
VITE_SENTRY_ENVIRONMENT=production
VITE_SENTRY_RELEASE=
VITE_SENTRY_TRACES_SAMPLE_RATE=0.1
VITE_SOCIAL_WHATSAPP_URL=
VITE_SOCIAL_INSTAGRAM_URL=
VITE_SOCIAL_THREADS_URL=
VITE_SOCIAL_FACEBOOK_URL=
VITE_SOCIAL_X_URL=
VITE_SOCIAL_LINKEDIN_URL=
VITE_SOCIAL_GOOGLE_BUSINESS_URL=
VITE_SOCIAL_PATREON_URL=

# Application runtime
NODE_ENV=production
PORT=8080
APP_PUBLIC_URL=https://kindred.example.com
BASE_PATH=/
LOG_LEVEL=info
TRUST_PROXY_HOPS=1

# PostgreSQL. Use a separate schema-owner URL only for migrations.
DATABASE_URL=postgresql://kindred:change-me@postgres:5432/kindred
MIGRATION_DATABASE_URL=
PG_SSL_CA=

# Clerk authentication
CLERK_SECRET_KEY=
CLERK_PUBLISHABLE_KEY=
CLERK_WEBHOOK_SECRET=

# AI provider: ollama, openai, bedrock, or disabled
AI_PROVIDER=ollama
AI_REQUEST_TIMEOUT_MS=30000
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=gemma3:4b
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-5-mini
AWS_REGION=us-east-1
BEDROCK_MODEL_ID=
# Prefer an IAM role/workload identity. Set these only when static or temporary
# AWS credentials are required.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=

# Helcim payments. When disabled, the remaining HELCIM_* entries may be blank.
HELCIM_PAYMENTS_ENABLED=false
HELCIM_API_KEY=
HELCIM_WEBHOOK_SECRET=
HELCIM_CUSTOMER_REFERENCE_SECRET=
HELCIM_YEARLY_PLAN_ID=
HELCIM_LIFETIME_PRODUCT_ID=
HELCIM_YEARLY_CHECKOUT_URL=
HELCIM_LIFETIME_CHECKOUT_URL=
HELCIM_LIFETIME_INVOICE_PREFIX=KINDRED-LIFETIME-
HELCIM_PORTAL_URL=
HELCIM_EMAIL_MIGRATION_FALLBACK=false

# Subscription policy
SUBSCRIPTION_OWNER_IDS=
SUBSCRIPTION_OWNER_EMAILS=
DAILY_CHAT_LIMIT=100

# Email (required in production)
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# Optional SMS reminders; configure all three together.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Optional voice synthesis
ELEVENLABS_API_KEY=

# Optional Google Calendar integration; configure the complete group or none.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALENDAR_REDIRECT_URI=
CALENDAR_OAUTH_STATE_SECRET=
CALENDAR_TOKEN_ENCRYPTION_KEY=

# Server observability; leave SENTRY_DSN blank to disable server reporting.
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
SENTRY_RELEASE=
SENTRY_TRACES_SAMPLE_RATE=0.1
