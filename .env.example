# =============================================================================
# Kindred Asterling AI Coaching — Environment Template
# =============================================================================
# This file contains variable NAMES ONLY. Never commit real values.
# Copy to .env and fill in locally, or use .env.1password with `op run`.

# ── Database ─────────────────────────────────────────────────────────────────
DATABASE_URL=
# PG_SSL_CA=          # PEM cert for self-signed Postgres in production (optional)

# ── Authentication / Sessions ────────────────────────────────────────────────
SESSION_SECRET=

# ── AI Providers ─────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=
AI_INTEGRATIONS_ANTHROPIC_API_KEY=
AI_INTEGRATIONS_ANTHROPIC_BASE_URL=
GEMINI_API_KEY=
AI_INTEGRATIONS_GEMINI_API_KEY=
AI_INTEGRATIONS_GEMINI_BASE_URL=

# ── Payments (Helcim) ────────────────────────────────────────────────────────
HELCIM_API_KEY=
HELCIM_WEBHOOK_SECRET=
HELCIM_YEARLY_PLAN_ID=
HELCIM_LIFETIME_PRODUCT_ID=
HELCIM_YEARLY_CHECKOUT_URL=
HELCIM_LIFETIME_CHECKOUT_URL=
HELCIM_PORTAL_URL=https://kindred-asterling-ai.helcim.app/login

# ── Messaging: SMS (Twilio) ─────────────────────────────────────────────────
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# ── Messaging: Email (Resend) ────────────────────────────────────────────────
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# ── Voice (ElevenLabs) ──────────────────────────────────────────────────────
ELEVENLABS_API_KEY=

# ── Application / Runtime ────────────────────────────────────────────────────
PORT=8080
NODE_ENV=development
APP_PUBLIC_URL=
RAILWAY_PUBLIC_DOMAIN=
LOG_LEVEL=info

# ── Feature Flags / App Logic ───────────────────────────────────────────────
CALENDAR_OWNER_USER_ID=
SUBSCRIPTION_OWNER_IDS=
SUBSCRIPTION_OWNER_EMAILS=
DAILY_CHAT_LIMIT=100
