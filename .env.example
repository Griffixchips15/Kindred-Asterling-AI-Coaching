# Kindred Asterling AI Coaching configuration
# Copy this file for local development. In Coolify, enter runtime values as
# environment variables/secrets; never bake server secrets into the image.

# =============================================================================
# BUILD-TIME PUBLIC BROWSER CONFIGURATION
# =============================================================================
# VITE_* values are embedded in frontend JavaScript during `docker build` and
# are visible to every visitor. In Coolify, configure this as a build argument.
VITE_CLERK_PUBLISHABLE_KEY=

# Browser error monitoring. The DSN is public by design; the auth token is not.
VITE_SENTRY_DSN=
VITE_SENTRY_ENVIRONMENT=production
VITE_SENTRY_RELEASE=
VITE_SENTRY_TRACES_SAMPLE_RATE=0.1

# =============================================================================
# RUNTIME SERVER CONFIGURATION (not available to Vite/browser code)
# =============================================================================
NODE_ENV=production
PORT=8080
APP_PUBLIC_URL=https://kindred.example.com
LOG_LEVEL=info
# Number of reverse proxies between the internet and Express (Coolify default: 1).
TRUST_PROXY_HOPS=1

# Server error monitoring. Leave SENTRY_DSN blank to disable Sentry cleanly.
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
SENTRY_RELEASE=
SENTRY_TRACES_SAMPLE_RATE=0.1

# PostgreSQL
DATABASE_URL=postgresql://kindred:change-me@postgres:5432/kindred
# Optional PEM CA certificate when PostgreSQL uses a private/self-signed CA.
PG_SSL_CA=

# Clerk authentication (server runtime values)
CLERK_SECRET_KEY=
CLERK_PUBLISHABLE_KEY=
CLERK_WEBHOOK_SECRET=
# This file contains variable NAMES ONLY. Never commit real values.
# Copy to .env and fill in locally, or use .env.1password with `op run`.

# ── Database ─────────────────────────────────────────────────────────────────
DATABASE_URL=         # Restricted application role
MIGRATION_DATABASE_URL= # Schema-owner role; migration job/startup only
PG_SSL_CA=             # Required PEM CA for private/self-signed production certificates

# ── Authentication (Clerk owns identity, verification, and sessions) ─────────
CLERK_SECRET_KEY=
CLERK_PUBLISHABLE_KEY=
VITE_CLERK_PUBLISHABLE_KEY=
CLERK_WEBHOOK_SECRET=

# AI provider: Ollama is the supported coaching provider.
# ── AI Providers ─────────────────────────────────────────────────────────────
# ollama (default), openai, or disabled. Hosted credentials belong only in the
# API container/server secret store; never expose them through frontend env.
AI_PROVIDER=ollama
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=gemma3:4b
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
# OPENAI_BASE_URL=https://api.openai.com/v1  # optional compatible endpoint
AI_REQUEST_TIMEOUT_MS=30000

# Helcim payments. When false, the remaining HELCIM_* values may be blank.
HELCIM_PAYMENTS_ENABLED=false
HELCIM_API_KEY=
HELCIM_WEBHOOK_SECRET=
# Separate HMAC secret used to bind Helcim customers to Kindred accounts.
HELCIM_CUSTOMER_REFERENCE_SECRET=
HELCIM_YEARLY_PLAN_ID=
HELCIM_LIFETIME_PRODUCT_ID=
HELCIM_YEARLY_CHECKOUT_URL=
HELCIM_LIFETIME_CHECKOUT_URL=
HELCIM_LIFETIME_INVOICE_PREFIX=KINDRED-LIFETIME-
HELCIM_PORTAL_URL=

# Subscription policy
SUBSCRIPTION_OWNER_IDS=
SUBSCRIPTION_OWNER_EMAILS=
DAILY_CHAT_LIMIT=100

# Email (required in production by validateRuntimeConfig)
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# Optional SMS reminders (configure all three together)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Optional voice synthesis
ELEVENLABS_API_KEY=

# Optional Google Calendar integration (configure the complete group or none)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALENDAR_REDIRECT_URI=https://kindred.example.com/api/calendar/callback
CALENDAR_OAUTH_STATE_SECRET=
CALENDAR_TOKEN_ENCRYPTION_KEY=

# ── Public social profiles (publish only verified HTTPS profile URLs) ─────────
VITE_SOCIAL_WHATSAPP_URL=
VITE_SOCIAL_INSTAGRAM_URL=
VITE_SOCIAL_THREADS_URL=
VITE_SOCIAL_FACEBOOK_URL=
VITE_SOCIAL_X_URL=
# Leave blank until the correct Kindred or owner profile is confirmed.
VITE_SOCIAL_LINKEDIN_URL=
VITE_SOCIAL_GOOGLE_BUSINESS_URL=
VITE_SOCIAL_PATREON_URL=
