aws_region         = "us-east-1"
cluster_name       = "kindred-production"
kubernetes_version = "1.33"
cluster_admin_role_arn = "arn:aws:iam::123456789012:role/kindred-platform-admin"

# Leave empty when Terraform runs inside the VPC. Otherwise add only your
# corporate VPN/NAT egress ranges; 0.0.0.0/0 is rejected.
public_access_cidrs = ["203.0.113.10/32"]

tags = {
  Application = "kindred"
  Environment = "production"
  ManagedBy   = "terraform"
  Owner       = "platform"
}
